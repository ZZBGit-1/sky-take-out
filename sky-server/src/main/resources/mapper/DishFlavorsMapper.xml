<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.DishFlavorsMapper">

    <!--新增口味-->
    <insert id="insertBatch">
        insert into dish_flavor (dish_id, name, value)
        values
        <foreach collection="flavors" item="item" separator=",">
            (#{item.dishId}, #{item.name}, #{item.value})
        </foreach>
    </insert>
    <!--删除口味-->
    <delete id="deleteByDishIds">
        delete from dish_flavor where dish_id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <!--根据菜品id删除口味数据-->
    <delete id="deleteByDishId">
        delete from dish_flavor where dish_id = #{id}
    </delete>
    <!--根据菜品id查询口味数据-->
    <select id="getByDishId" resultType="com.sky.entity.DishFlavor">
        select  * from dish_flavor
        where dish_id = #{id}
    </select>
</mapper>
